{
  "manifest_version": 3,
  "name": "Bria API Inspector",
  "key": "",
  "version": "0.1.0",
  "description": "Captures recent Bria API requests + responses and reports them to the Model Feedback Hub or Jira.",
  "permissions": [
    "debugger",
    "storage",
    "activeTab",
    "tabs",
    "identity"
  ],
  "oauth2": {
    "client_id": "REPLACE_WITH_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/spreadsheets"]
  },
  "host_permissions": [
    "https://*.bria-api.com/*",
    "https://*.bria.ai/*",
    "https://sheets.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Bria API Inspector"
  },
  "options_page": "options.html"
}
